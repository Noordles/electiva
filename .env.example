# Copy to .env if you need different local ports.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_PORT=5173
# Optional absolute local DB path. Default uses LOCALAPPDATA/Electiva on Windows.
# Synced OneDrive paths and in-memory databases are rejected for runtime storage.
# DATABASE_PATH=C:/Users/your-name/AppData/Local/Electiva/dev.sqlite
# Separate proposed directory simulator; start with npm run dev:directory.
DIRECTORY_URL=http://127.0.0.1:3100
# Only for local HTTP production-mode checks on this loopback-only application.
# HTTPS hosting must use Secure cookies. Development HTTP already works normally.
# COOKIE_SECURE=false
